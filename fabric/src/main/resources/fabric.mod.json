{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/Sz-Yuan/RarityGlow"
  },
  "license": "${license}",
  "icon": "assets/rarityglow/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "kitejs.fabric.RarityGlowFabric"
    ],
    "modmenu": [
      "kitejs.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "rarityglow.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "cloth-config": ">=${cloth_config_version}"
  },
  "recommends": {
    "modmenu": ">=${modmenu_version}"
  },
  "suggests": {}
}
